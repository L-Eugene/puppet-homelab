network_config:
  ass-teriks:
    content:
      connection:
        id: ass-teriks
        type: wifi
        permissions: ''
      wifi:
        ssid: ass-teriks
        mode: infrastructure
      wifi-security:
        key-mgmt: wpa-psk
        psk: ENC[PKCS7,]
      ipv4:
        dns-search: ''
        method: auto
      ipv6:
        dns-search: ''
        method: auto
        addr-gen-mode: stable-privacy
  mikrotik_static:
    content:
      connection:
        id: Mikrotik Static
        type: ethernet
        permissions: ''
        autoconnect: 'false'
      ethernet:
        mac-address-blacklist:
      ipv4:
        address1: '192.168.88.10/24,192.168.88.1'
        method: manual
        dns-search: ''
        method: auto
      ipv6:
        dns-search: ''
        method: auto
  default_ethernet:
    content:
      connection:
        id: DHCP
        type: ethernet
        permissions: ''
        autoconnect: 'true'
      ethernet:
        mac-address-blacklist:
      ipv4:
        dns-search: ''
        method: auto
      ipv6:
        dns-search: ''
        method: auto
  home_vpn:
    content:
      connection:
        id: ENC[PKCS7,]
        type: vpn
        autoconnect: 'false'
      vpn:
        remote: ENC[PKCS7,]
        service-type: 'org.freedesktop.NetworkManager.openvpn'
        auth: 'SHA1'
        cert-pass-flags: 0
        cipher: 'AES-256-CBC'
        connection-type: 'tls'
        proto-tcp: 'yes'
        ca: /opt/vpn_keys/home_vpn_ca.crt
        cert: /opt/vpn_keys/home_vpn.crt
        key: /opt/vpn_keys/home_vpn.key
      ipv4:
        dns-search: ''
        method: 'auto'
        never-default: 'true'
      ipv6:
        dns-search: ''
        method: 'auto'
        addr-gen-mode: 'stable-privacy'
