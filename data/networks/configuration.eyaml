---
network_config:
  ass-teriks:
    content:
      connection:
        id: ass-teriks
        type: wifi
        permissions: ''
      wifi:
        ssid: ass-teriks
        mode: infrastructure
      wifi-security:
        key-mgmt: wpa-psk
        psk: 123
      ipv4:
        dns-search: ''
        method: auto
      ipv6:
        dns-search: ''
        method: auto
        addr-gen-mode: stable-privacy
    